{
  "name": "mini-note",
  "version": "1.0.0",
  "description": "Mini Note - 可爱扁平化记事应用",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "install:all": "pnpm -C backend install && pnpm -C frontend install",
    "dev": "concurrently -n be,fe -c cyan,magenta --kill-others-on-fail \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "dev:backend": "pnpm -C backend dev",
    "dev:frontend": "pnpm -C frontend dev",
    "start": "pnpm -C backend start",
    "build": "pnpm -C frontend build",
    "preview": "pnpm build && pnpm -C frontend preview",
    "db:init": "pnpm -C backend db:init",
    "db:migrate": "pnpm -C backend db:migrate",
    "db:admin": "pnpm -C backend db:admin",
    "task:share-clean": "node -e \"require('./backend/scheduler').cleanExpiredShares()\"",
    "task:orphan-clean": "node -e \"require('./backend/scheduler').cleanOrphanUploads()\"",
    "task:reminders": "node -e \"require('./backend/scheduler').sendDueDateReminders()\"",
    "task:push": "node -e \"require('./backend/scheduler').sendPushReminders()\"",
    "clean": "rimraf frontend/dist backend/logs/*.log",
    "clean:all": "rimraf frontend/dist frontend/node_modules backend/node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "rimraf": "^6.0.1"
  }
}